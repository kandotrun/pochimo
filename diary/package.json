{
  "name": "pochimo-diary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts",
    "dev:node": "tsx watch server.ts",
    "start": "bun server.ts",
    "start:node": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "biome check . && tsc --noEmit && bun test",
    "format": "biome format --write .",
    "report": "bun scripts/generate-report.ts"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "hono": "^4.12.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "bun": "^1.3.13",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
