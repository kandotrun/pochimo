# Optional: Ollama Cloud API key for cloud vision/report generation.
# Never commit a real key.
OLLAMA_API_KEY=

# Initial owner setup token. Set a strong value before exposing the app.
SETUP_TOKEN=change-this-before-public-use

# Runtime data directory. Keep this private and out of git.
DATA_DIR=./data

# Cloud models
OLLAMA_CLOUD_URL=https://ollama.com/v1
OLLAMA_CLOUD_VISION_MODEL=gemma4:31b
OLLAMA_CLOUD_MODEL=deepseek-v4-pro

# Local fallback
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=moondream
PORT=8787

# Public domains / allowed origins
PUBLIC_MARKETING_ORIGIN=http://localhost:8787
PUBLIC_APP_ORIGIN=http://localhost:8787

# Email via Resend
RESEND_API_KEY=
MAIL_FROM="Pochimo <noreply@example.com>"
MAIL_REPLY_TO=
